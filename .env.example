# 环境变量清单（仅作参考）
# 本项目没有使用 python-dotenv，代码不会自动读取 .env 文件。
# 请在启动服务/脚本之前于 shell 中设置，例如：
#   PowerShell :  $env:ITSM_DB="itsm_triage"
#   CMD        :  set ITSM_DB=itsm_triage
#   bash       :  export ITSM_DB=itsm_triage

# ---- PostgreSQL ----
ITSM_DB=itsm_triage
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
# 代码不传 password；若 PG 要求认证，由 libpq 读取 PGPASSWORD 或 pgpass.conf。
# 切勿把真实密码写进仓库。
# PGPASSWORD=

# ---- Ollama ----
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=qwen3-embedding:4b
# 原生 2560 维，按 Matryoshka 前缀截断；须与 sql/01_schema.sql 的 vector(1024) 一致
EMBED_DIM=1024
EMBED_BATCH=16
# 默认只灌 3000 条向量，设为 0 表示全量
ITSM_EMBED_LIMIT=3000

# ---- Web 服务 ----
# 设为 1 可禁止各页面服务自动打开浏览器
ITSM_NO_BROWSER=0

# ---- 仅 Windows .bat 启动脚本使用 ----
# PG_BIN / PG_DATA 不在这里设置，请复制到 启动项/local_env.bat
# （以 启动项/local_env.example.bat 为模板，该文件已被 .gitignore 排除）。
