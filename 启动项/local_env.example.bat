@echo off
rem Copy this file to local_env.bat (gitignored) and edit the values for your machine.
rem If PostgreSQL is already running and pg_isready is on PATH, no config is needed.
rem PG_BIN  = folder containing pg_isready.exe / pg_ctl.exe
rem PG_DATA = PostgreSQL data directory, used only when PG needs to be started.
rem set "PG_BIN=C:\path\to\pgsql\bin"
rem set "PG_DATA=C:\path\to\pgdata"
exit /b 0
